# Keep false for local development. Enable when the observability profile is running.
OTEL_ENABLED=false

# Required only for: docker compose --profile observability up -d
# Use the Dynatrace OTLP base endpoint for your tenant.
DT_ENDPOINT=https://YOUR_ENVIRONMENT.live.dynatrace.com/api/v2/otlp
DT_API_TOKEN=replace-me

# The application containers use this internal Collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
